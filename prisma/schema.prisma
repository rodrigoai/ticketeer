generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id                Int      @id @default(autoincrement())
  name              String
  public_hash       String   @unique
  event_image_url   String?
  mobile_event_image_url String?
  promotional_image String?
  opening_datetime  DateTime
  closing_datetime  DateTime
  map_image         String?
  description       String?
  additional_information String?
  venue             String?
  sale_mode         String   @default("checkout")
  checkout_page_id  String?
  checkout_page_title String?
  cart_payment_service_id String?
  reservation_expires_in_minutes Int @default(10)
  created_by        String
  nextTicketNumber  Int      @default(1)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  status            String   @default("active")
  tickets           Ticket[]
  ticketGroups      TicketGroup[]

  @@map("events")
}

model TicketGroup {
  id           Int      @id @default(autoincrement())
  eventId       Int
  groupKey      String
  description   String
  sales_description String?
  table         Int?
  checkout_url  String?
  product_id    Int?
  color         String?
  active        Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  pricingTiers  TicketGroupPricingTier[]

  @@unique([eventId, groupKey])
  @@map("ticket_groups")
}

model TicketGroupPricingTier {
  id            Int        @id @default(autoincrement())
  ticketGroupId Int
  name          String
  type          String     @default("period")
  start_at      DateTime?
  end_at        DateTime?
  quantity      Int?
  position      Int        @default(0)
  price         Decimal
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  ticketGroup   TicketGroup @relation(fields: [ticketGroupId], references: [id], onDelete: Cascade)

  @@index([ticketGroupId, position])
  @@map("ticket_group_pricing_tiers")
}

model UserProfile {
  id                  String   @id
  nova_money_api_key  String
  nova_money_tenant   String
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@map("user_profiles")
}

model Ticket {
  id                   Int       @id @default(autoincrement())
  eventId              Int
  description          String
  identificationNumber Int
  location             String?
  table                Int?
  price                Decimal
  order                String?
  buyer                String?
  buyerDocument        String?
  buyerPhone           String?
  reservationKey       String?
  reservedAt           DateTime?
  reservedUntil        DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  buyerEmail           String?
  salesEndDateTime     DateTime?
  checkedIn            Boolean   @default(false)
  checkedInAt          DateTime?
  qrCodeHash           String?   @unique
  accessoryCollected   Boolean   @default(false)
  accessoryCollectedAt DateTime?
  accessoryCollectedNotes String?
  event                Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, identificationNumber])
  @@map("tickets")
}
